> +		interrupts-extended =3D <&tlmm 31 IRQ_TYPE_EDGE_RISING>;
> +		en-gpios =3D <&tlmm 56 GPIO_ACTIVE_HIGH>;
> +		wake-gpios =3D <&tlmm 7 GPIO_ACTIVE_HIGH>;
> +		clocks =3D <&rpmhcc RPMH_LN_BB_CLK2>;
