+	/*
+	 * Samsung NFC controller.
+	 *
+	 * GPIO wiring below is taken directly from Fairphone's published
+	 * GPL devicetree source for this hardware (samsung/volcano-nfc-
+	 * samsung-sec-slsi.dtsi in their nfc-devicetree repo), not guessed.
+	 *
+	 * UNVERIFIED: the exact chip generation. Fairphone's vendor driver
+	 * config filenames reference "rn4v", which looks like a newer
+	 * Samsung NFC IC generation than S3FWRN5 (the chip the mainline
+	 * "samsung,s3fwrn5-i2c" driver targets below). The transport-level
+	 * protocol has stayed similar across generations, so this may well
+	 * probe and work, but treat it as the first thing to check against
+	 * real hardware (dmesg on probe, does it survive CORE_RESET) rather
+	 * than assumed correct.
+	 *
+	 * UNVERIFIED: interrupt trigger type (EDGE_RISING is the datasheet-
+	 * typical default for this chip family, not confirmed for this unit).
+	 *
+	 * NOT WIRED: NFC_CLK_REQ (gpio6 downstream). No equivalent property
+	 * exists in the mainline binding - likely a request line to an
+	 * externally-gated oscillator the mainline driver doesn't model.
+	 * Pinctrl state left in place below in case it turns out to matter.
+	 */
+	nfc@27 {
+		compatible = "samsung,s3fwrn5-i2c";
+		reg = <0x27>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <31 IRQ_TYPE_EDGE_RISING>;
+		en-gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
+		wake-gpios = <&tlmm 7 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&nfc_irq_default &nfc_clk_req_default>;
+	};
 };
 
